{
  "name": "dsh-tally-monorepo",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "build": "pnpm -r run build",
    "pretest": "pnpm -r run build",
    "test": "vitest run",
    "pretest:e2e": "pnpm -r run build",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:perf": "vitest run --config vitest.perf.config.ts",
    "pretypecheck": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck"
  },
  "devDependencies": {
    "@deepseek-ai/dsh": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm-mock-server": "0.2.0-rc.2",
    "@types/node": "^22",
    "dsh-trust-check": "0.2.1",
    "typescript": "~5.8",
    "vitest": "^3"
  }
}
