{
  "name": "dsh-tally-api",
  "version": "0.1.0-beta.0",
  "description": "dsh-tally 的类型接口：用量、计价、余额、预算服务和事件，供其他 dsh 插件依赖",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "types",
    "usage",
    "cost"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wfengq/dsh.git",
    "directory": "packages/tally-api"
  },
  "homepage": "https://github.com/wfengq/dsh/tree/main/packages/tally-api#readme",
  "bugs": "https://github.com/wfengq/dsh/issues",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "files": [
    "lib",
    "LICENSE"
  ],
  "scripts": {
    "build": "node ../../scripts/clean-lib.mjs && tsc -p .",
    "typecheck": "tsc -p . --noEmit"
  },
  "dependencies": {
    "dsh-pricing-data": "workspace:^"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.4-0 <4.1.0-0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4"
  },
  "publishConfig": {
    "access": "public",
    "tag": "beta"
  }
}
