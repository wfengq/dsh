{
  "name": "dsh-tally-balance-deepseek",
  "version": "0.1.0-beta.1",
  "description": "为 dsh-tally 提供 DeepSeek 余额查询（API key 与官方账号两种方式）",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "balance"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wfengq/dsh.git",
    "directory": "packages/balance-deepseek"
  },
  "homepage": "https://github.com/wfengq/dsh/tree/main/packages/balance-deepseek#readme",
  "bugs": "https://github.com/wfengq/dsh/issues",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "node ../../scripts/clean-lib.mjs && tsc -p .",
    "typecheck": "tsc -p . --noEmit"
  },
  "dependencies": {
    "dsh-tally-api": "workspace:^"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.4-0 <4.1.0-0 || >=4.0.5-0 <4.1.0-0",
    "@deepseek-ai/dsh-credentials": ">=0.2.0-0 <0.3.0-0 || >=0.2.1-0 <0.3.0-0",
    "@deepseek-ai/dsh-deepseek-account": ">=0.2.0-0 <0.3.0-0 || >=0.2.1-0 <0.3.0-0",
    "@deepseek-ai/schemastery": ">=3.18.4-0 <3.19.0-0 || >=3.18.5-0 <3.19.0-0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-credentials": "0.2.0-rc.2",
    "@deepseek-ai/dsh-deepseek-account": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "3.18.4"
  },
  "publishConfig": {
    "access": "public",
    "tag": "beta"
  }
}
