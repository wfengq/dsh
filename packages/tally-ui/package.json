{
  "name": "dsh-tally-ui",
  "version": "0.1.0-beta.0",
  "description": "dsh-tally 的参考界面：费用条、每轮费用、会话累计、用量看板、预算提醒和设置页",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "usage",
    "cost",
    "ui"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wfengq/dsh.git",
    "directory": "packages/tally-ui"
  },
  "homepage": "https://github.com/wfengq/dsh/tree/main/packages/tally-ui#readme",
  "bugs": "https://github.com/wfengq/dsh/issues",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "remote",
        "slots",
        "locale",
        "configForms"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p . && tsc -p tsconfig.client.json && tsdown",
    "typecheck": "tsc -p . --noEmit && tsc -p tsconfig.client.json --noEmit"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.4-0 <4.1.0-0",
    "@deepseek-ai/schemastery": ">=3.18.4-0 <3.19.0-0",
    "dsh-tally": ">=0.1.0-0 <0.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/cosmokit": "1.8.5",
    "@deepseek-ai/dsh-api-remotes": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-locale": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-chat": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-session": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.0-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "3.18.4",
    "@testing-library/dom": "10.4.0",
    "@testing-library/react": "16.3.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.7",
    "dsh-tally": "workspace:^",
    "dsh-tally-api": "workspace:^",
    "jsdom": "26.1.0",
    "react": "^18.2.0",
    "react-dom": "18.3.1",
    "tsdown": "0.23.1"
  },
  "publishConfig": {
    "access": "public",
    "tag": "beta"
  }
}
